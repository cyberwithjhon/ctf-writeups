  │
  └── 6379/tcp → Redis 5.0.7
                    │
                    ├── redis-cli
                    │
                    ├── KEYS *
                    │      ├── flag
                    │      ├── temp
                    │      ├── stor
                    │      └── numb
                    │
                    └── GET flag
                           │
